# pcwall environment configuration.
# Copy this file to .env and fill in the blanks. .env is ignored by git; this
# example file ships with empty secrets and may be committed freely.

# --- Web service -----------------------------------------------------------
# Interface and port the Starlette/uvicorn service binds to.
PCWALL_HOST=0.0.0.0
PCWALL_PORT=8770

# --- Agent access ----------------------------------------------------------
# Shared secret HomeAgent presents over HTTP. Leave empty to disable the
# "agent" role entirely; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PCWALL_KEY=

# --- Locale ----------------------------------------------------------------
# IANA zone name used for the wall's clock, timers, and daily rollovers.
TIMEZONE=America/Los_Angeles

# --- Google (optional, read-only connectors for the separate family account) --
# OAuth client downloaded from Google Cloud Console. Keep the real file out of
# git; credentials.json is ignored by default.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Directory where per-account OAuth tokens are cached after first sign-in.
GOOGLE_TOKEN_DIR=config/
# Google account label the wall reads calendar and photos from.
GOOGLE_FAMILY_ACCOUNT=family

# --- Storage ---------------------------------------------------------------
# Override the wall document location (default: data/pcwall.json under the repo root).
PCWALL_DATA_PATH=
# Household configuration (members, pairing codes). Ignored by git.
PCWALL_FAMILY_CONFIG=config/family.json
